FLUPORT_DATABASE_URL=postgresql+psycopg://fluport:fluport@localhost:5432/fluport
FLUPORT_SIM_SEMILLA=42
FLUPORT_SIM_VELOCIDAD=60
# API key de Gemini (Google AI Studio). No la subas al repositorio: .env está en .gitignore
FLUPORT_LLM_API_KEY=
FLUPORT_LLM_MODELO=gemini-3.6-flash
# Razonamiento de Gemini 3: minimal | low | medium | high (más alto = más lento)
FLUPORT_LLM_PENSAMIENTO=low
# Modelo que se usa si el principal está saturado (503/429) o tarda más de FLUPORT_LLM_TIMEOUT_S
FLUPORT_LLM_MODELO_RESPALDO=gemini-3.5-flash-lite
FLUPORT_LLM_TIMEOUT_S=12
# Avisos proactivos por Telegram (recordatorio 30 min antes, contingencias)
FLUPORT_AVISOS_ACTIVOS=true

# Telegram: crea el bot con @BotFather (/newbot) y pega aquí el token
FLUPORT_TELEGRAM_TOKEN=
# polling = sin URL pública (recomendado en local) · webhook = para hosting · off = desactivado
FLUPORT_TELEGRAM_MODO=polling
FLUPORT_TELEGRAM_WEBHOOK_SECRET=
# true (operación real): el bot solo vincula números que una agencia dio de alta; false: cualquiera puede registrarse
FLUPORT_TELEGRAM_SOLO_REGISTRADOS=true
# SMS para transportistas sin smartphone: android = celular con la app SMS Gateway · adb = celular por USB · twilio · vonage · off
FLUPORT_SMS_PROVEEDOR=android
# android (red local): http://<ip-del-celular>:8080/message · twilio: se arma solo con el SID
FLUPORT_SMS_URL=
# android: usuario y contraseña que muestra la app · twilio: Account SID y Auth Token · vonage: API Key y API Secret
FLUPORT_SMS_USUARIO=
FLUPORT_SMS_CLAVE=
# twilio: número remitente · vonage: número o nombre (vacío = "Fluport")
FLUPORT_SMS_REMITENTE=
FLUPORT_SMS_TIMEOUT_S=10
# adb (Android por USB con depuración activada): ruta de adb, serial si hay varios y "x,y" del botón Enviar
FLUPORT_SMS_ADB_RUTA=
FLUPORT_SMS_ADB_SERIAL=
FLUPORT_SMS_ADB_TAP=
FLUPORT_SMS_ADB_ESPERA_S=2
# true solo para probar el asistente con curl en local; nunca en una URL pública (no autentica al remitente)
FLUPORT_ASISTENTE_WEB_ACTIVO=false
